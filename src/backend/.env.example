# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ─────────────────────────────────────────────────────────────────
# Google Gemini AI  (required for live AI features)
# Get a free key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default model (gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────────
# IBM watsonx.ai  (legacy — no longer used by default)
# ─────────────────────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─────────────────────────────────────────────────────────────────
# CORS — Production Frontend URL (Render only)
# Set this to your Vercel deployment URL after first deploy.
# Comma-separate multiple origins if needed.
# ─────────────────────────────────────────────────────────────────
# FRONTEND_URL=https://clutch-nexus.vercel.app

# ─────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
